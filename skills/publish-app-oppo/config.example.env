# Recommended: copy to ~/.config/ai-ignore-config/<项目名>/oppo.env
# Do not commit config.env or paste API keys into chat.

# 管理中心 → 产品导航 → 我的API → 创建服务端应用 里的客户端ID（19 位）
OPPO_CLIENT_ID=

# 同一处的密钥 client_secret（64 位）。不是登录密码。
OPPO_CLIENT_SECRET=

# Required: app package name registered on the OPPO console (this project's applicationId).
OPPO_PACKAGE_NAME=

# 默认发布类型：1=审核立即发布，2=定时发布（需再传 --sche-online-time）
OPPO_ONLINE_TYPE=1
