# Recommended: copy to ~/.config/ai-ignore-config/<项目名>/xiaomi.env
# Do not commit config.env or paste private keys/passwords into chat.

# Xiaomi developer login email.
XIAOMI_USER_NAME=

# Xiaomi API private key from the developer console. This is not the login password.
XIAOMI_PRIVATE_KEY=

# Local path to the Xiaomi public certificate file downloaded from the console.
XIAOMI_PUBLIC_CERT_PATH=

# Required: app package name (this project's applicationId).
XIAOMI_PACKAGE_NAME=

# Optional defaults used by push.
XIAOMI_APP_NAME=
XIAOMI_PUBLISHER_NAME=
XIAOMI_CATEGORY=
XIAOMI_KEYWORDS=
XIAOMI_PRIVACY_URL=
XIAOMI_BRIEF=
