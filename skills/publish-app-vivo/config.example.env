# Recommended: copy to ~/.config/ai-ignore-config/<项目名>/vivo.env
# Do not commit config.env or paste API keys into chat.

# 管理中心 → 账号管理 → api管理 → 立即开通 后分配的 access_key
VIVO_ACCESS_KEY=

# 同一处分配的 access_secret。不是登录密码。
VIVO_ACCESS_SECRET=

# Required: app package name registered on the vivo console (this project's applicationId).
VIVO_PACKAGE_NAME=

# 默认上架类型：1=实时上架，2=定时上架（需再传 --sche-online-time）
VIVO_ONLINE_TYPE=1

# 兼容设备：1=手机，2=手机和平板，3=平板
VIVO_COMPATIBLE_DEVICE=2
