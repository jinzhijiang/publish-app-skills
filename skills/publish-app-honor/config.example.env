# Recommended: copy to ~/.config/ai-ignore-config/<项目名>/honor.env
# Do not commit config.env or paste API keys into chat.

# 管理中心 → 开放能力 → 凭证 → API密钥 里的 Client_id
HONOR_CLIENT_ID=

# 同一处申请的密钥（client_secret）。不是登录密码。
HONOR_CLIENT_SECRET=

# Required: app package name bound on the Honor console (this project's applicationId).
HONOR_PACKAGE_NAME=

# Optional: skip the get-app-id lookup by pinning the appId.
HONOR_APP_ID=

# Language the APK and newFeature are bound to by default.
HONOR_DEFAULT_LANGUAGE=zh-CN
