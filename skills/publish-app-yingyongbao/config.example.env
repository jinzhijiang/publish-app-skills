# Recommended: copy to ~/.config/ai-ignore-config/<项目名>/yingyongbao.env (same path on every machine).
# Alternative: copy to config.env next to this file (also gitignored + cursorignored).
#
# Obtain credentials from Tencent Open Platform:
#   应用 → 账户管理 → API发布接口 → 申请开通 → access_secret
#   app_id / pkg_name from 安卓应用管理 → 应用首页
#
# First-time setup:
#   mkdir -p ~/.config/ai-ignore-config/<项目名>
#   cp config.example.env ~/.config/ai-ignore-config/<项目名>/yingyongbao.env
#   # edit ~/.config/ai-ignore-config/<项目名>/yingyongbao.env

YINGYONGBAO_USER_ID=
YINGYONGBAO_ACCESS_SECRET=
YINGYONGBAO_APP_ID=
# Required: this project's applicationId.
YINGYONGBAO_PKG_NAME=
