# =============================================================================
# Huawei AppGallery Connect 发版配置（按项目隔离）
# 复制到 ~/.config/ai-ignore-config/<项目名>/appgallery.env 后填写，
# <项目名> 即目标项目的 git 根目录名（脚本按它自动找配置，跑错目录会报错缺配置，
# 不会静默发错应用）。
# 切勿提交真实凭据；服务账号密钥文件(JSON)也不要放进仓库或贴到对话。
#
# 鉴权用「服务账号 Service Account」：AGC 用户与访问 → API密钥 → Connect API →
# 创建服务账号（类型选「开发者级」，角色要含发布权限）→ 下载 JSON 密钥文件 →
# 把绝对路径填到 HUAWEI_SERVICE_ACCOUNT_KEY。
# 服务账号是账号级凭据：一份密钥可发布该华为账号名下【所有】应用（含其他项目），
# Android 与 HarmonyOS 也共用同一份，只有 appId 不同。多项目共用一个华为账号时，
# 各项目的 appgallery.env 里 HUAWEI_SERVICE_ACCOUNT_KEY 可以指向同一个密钥文件。
# =============================================================================

# ---- 全局 ---------------------------------------------------------------------
# 数据处理位置：默认中国。德国/新加坡/俄罗斯分别用
# connect-api-dre / connect-api-dra / connect-api-drru.cloud.huawei.com。
HUAWEI_CONNECT_API_DOMAIN=connect-api.cloud.huawei.com
# 更新说明语言。
HUAWEI_DEFAULT_LANG=zh-CN
# 服务账号 token 端点，一般无需改动。
HUAWEI_SA_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
# 必填：服务账号密钥文件绝对路径(Android 与鸿蒙共用一份)。
HUAWEI_SERVICE_ACCOUNT_KEY=

# ---- Android ------------------------------------------------------------------
# 必填：appId。首次上架时在 AGC 控制台创建应用后即可看到；
# 已上传过包则可用 `appid-list --platform android` 按包名查。
HUAWEI_ANDROID_APP_ID=
# 本项目的 Android 包名（applicationId）。只用于 appid-list 查询与 doctor 自检，
# 上传绑定以 APK 内的包名为准。
HUAWEI_ANDROID_PACKAGE_NAME=
# 默认值，一般无需改动。
HUAWEI_ANDROID_PACKAGE_TYPE=1
# 默认产物路径（相对项目根），按 VasDolly 写 huawei 渠道后的产物给。
# 不打渠道包就改成 build/app/outputs/flutter-apk/app-release.apk。
HUAWEI_ANDROID_FILE=build/app/outputs/channels/huawei-app-release.apk
HUAWEI_ANDROID_FILE_TYPE=5

# ---- HarmonyOS ---------------------------------------------------------------
# 必填：appId(留空可用 `appid-list --platform ohos` 查)。
HUAWEI_OHOS_APP_ID=
# 本项目的鸿蒙 bundle name。同上，只用于查询与自检。
HUAWEI_OHOS_PACKAGE_NAME=
# 默认值，一般无需改动。
HUAWEI_OHOS_PACKAGE_TYPE=7
# 默认按 `flutter build app --release` 出的 App Pack 给；DevEco 直出 hap 时改成
# build/ohos/hap/entry-default-signed.hap。
HUAWEI_OHOS_FILE=build/ohos/app/ohos-release-signed.app
HUAWEI_OHOS_FILE_TYPE=5
