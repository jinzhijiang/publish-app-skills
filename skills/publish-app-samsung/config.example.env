# =============================================================================
# 三星 Galaxy Store Seller Portal 的项目侧配置（不是密钥，但都是项目/主体信息）
# 复制到 ~/.config/ai-ignore-config/<项目名>/samsung.env 后填写，
# <项目名> 即调用方项目的 git 根目录名。切勿提交到本仓库。
#
# 登录账号的密码、验证码由发布人在浏览器里手动完成，不写进这里、也不贴到对话。
# =============================================================================

# 控制台里的应用名，用于在应用列表中交叉确认目标（必填）
SAMSUNG_APP_NAME=
# applicationId，用于交叉确认（必填）
SAMSUNG_PACKAGE_NAME=
# 控制台 Content ID。首次跑通后填；**每次仍要用应用名+包名交叉确认**，不要当固定入口用
SAMSUNG_APP_ID=
