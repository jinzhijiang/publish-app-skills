# =============================================================================
# 科大讯飞 AI 学习机应用中心 的项目侧配置（不是密钥，但都是项目/主体信息）
# 复制到 ~/.config/ai-ignore-config/<项目名>/xunfei.env 后填写，
# <项目名> 即调用方项目的 git 根目录名。切勿提交到本仓库。
#
# 登录账号的密码、验证码由发布人在浏览器里手动完成，不写进这里、也不贴到对话。
# =============================================================================

# 控制台里的应用名，用于在应用列表中交叉确认目标（必填）
XUNFEI_APP_NAME=
# applicationId，用于交叉确认（必填）
XUNFEI_PACKAGE_NAME=
# 控制台 APP ID。首次跑通后填；**每次仍要用应用名+包名交叉确认**，不要当固定入口用
XUNFEI_APP_ID=
# 开发者账号（登录用；密码/验证码人工输入，不填这里）
XUNFEI_ACCOUNT=
# 服务备案：ICP 备案网址或备案号
XUNFEI_ICP=
# 应用分类：两级下拉，只能选一个（形如「一级分类 / 二级分类」）
XUNFEI_CATEGORY=
# 推荐学段，多选：幼儿 / 小学 / 初中 / 高中
XUNFEI_STAGE=
# 适用年龄，单选：3+ / 8+ / 12+ / 16+（每次提交都会被清空，必须按上一审核通过版本重选）
XUNFEI_AGE_RATING=
# 付费内容：会员收费 / 激活收费 / 课程收费 / 部分章节收费（图书阅读类）/ 其他
XUNFEI_PAY_TYPE=
# 广告类型：无 / 轻度广告 / 重度广告
XUNFEI_AD_TYPE=
